# Modèle des secrets du SERVEUR.
# Sur le serveur : copie ce fichier en ".env.prod.local" et remplis les vraies valeurs.
# ".env.prod.local" est déjà ignoré par Git (grâce au .gitignore de Symfony).

SERVER_NAME=mon-domaine.fr
APP_SECRET=remplace_par_une_longue_chaine_aleatoire
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=remplace_par_un_mot_de_passe_solide
MYSQL_ROOT_PASSWORD=remplace_par_un_autre_mot_de_passe_solide
