<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Suivi de projet{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📋</text></svg>">

        {# Bootstrap (mise en page) et Bootstrap Icons (icônes), chargés depuis un CDN #}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3/dist/css/bootstrap.min.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1/font/bootstrap-icons.min.css">

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3/dist/js/bootstrap.bundle.min.js" defer></script>
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="bg-light">

        {# ---------- Barre du haut ---------- #}
        <nav class="navbar navbar-expand bg-dark" data-bs-theme="dark">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_accueil') }}">
                    <i class="bi bi-kanban"></i> Suivi de projet
                </a>

                {# En haut à droite : connexion / déconnexion (cahier des charges 7.1, 7.10, 7.15) #}
                <div class="ms-auto d-flex align-items-center gap-3">
                    {% if app.user %}
                        <span class="navbar-text">
                            <i class="bi bi-person-circle"></i> {{ app.user.nom }}
                        </span>
                        {# Le lien sera branché à l'étape 3 (authentification) #}
                        <a class="btn btn-outline-light btn-sm" href="#">
                            <i class="bi bi-box-arrow-right"></i> Déconnexion
                        </a>
                    {% else %}
                        {# Le lien sera branché à l'étape 3 (authentification) #}
                        <a class="btn btn-outline-light btn-sm" href="#">
                            <i class="bi bi-box-arrow-in-right"></i> Authentification
                        </a>
                    {% endif %}
                </div>
            </div>
        </nav>

        <main class="container py-4">
            {# Messages de confirmation / d'erreur (addFlash dans les contrôleurs) #}
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
