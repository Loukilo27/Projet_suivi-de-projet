{#
    Visuel de l'état d'une tâche (cahier des charges 7.2) :
    pas commencé / en cours / fait / en retard.
    Utilisation : {% include '_partials/_etat_tache.html.twig' with {tache: tache} %}
#}
{% if tache.estEnRetard %}
    <span class="badge text-bg-danger"><i class="bi bi-exclamation-triangle"></i> En retard</span>
{% elseif tache.etat.value == 'fini' %}
    <span class="badge text-bg-success"><i class="bi bi-check-circle"></i> {{ tache.etat.label }}</span>
{% elseif tache.etat.value == 'en_cours' %}
    <span class="badge text-bg-primary"><i class="bi bi-play-circle"></i> {{ tache.etat.label }}</span>
{% else %}
    <span class="badge text-bg-secondary"><i class="bi bi-circle"></i> {{ tache.etat.label }}</span>
{% endif %}
